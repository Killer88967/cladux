{
  "name": "cladux",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm size",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "node scripts/clean.ts",
    "e2e": "pnpm --filter e2e e2e",
    "e2e:cli": "pnpm --filter e2e e2e:cli",
    "visual": "pnpm --filter visual harness && pnpm --filter visual shoot && pnpm --filter visual compare:styles",
    "size": "node scripts/size.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=cladux-ui --filter=cladux-registry --filter=cladux-html && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
