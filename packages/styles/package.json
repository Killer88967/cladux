{
  "name": "@cladux/styles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.css",
    "./tailwind.css": "./src/tailwind.css",
    "./base.css": "./src/base.css",
    "./utilities.css": "./src/utilities.css",
    "./components/*": "./src/components/*",
    "./cl.css": "./dist/cl.css"
  },
  "scripts": {
    "build": "node scripts/build.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@cladux/tokens": "workspace:*",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2"
  }
}
